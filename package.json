{
	"name": "@ovehbe/n8n-nodes-perfexcrm",
	"version": "0.1.4",
	"description": "n8n node for Perfex CRM - Customers, Invoices, and Payments",
	"keywords": [
		"n8n-community-node-package",
		"perfexcrm",
		"crm",
		"invoices",
		"customers",
		"payments"
	],
	"license": "MIT",
	"homepage": "https://github.com/ovehbe/perfexcrm-n8n-node",
	"author": {
		"name": "Ömer Vehbe",
		"email": "ovehbe@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ovehbe/perfexcrm-n8n-node.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials",
		"lintfix": "eslint nodes credentials --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/PerfexCrmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PerfexCrm/PerfexCrm.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.56.0",
		"gulp": "^4.0.2",
		"n8n-workflow": "*",
		"prettier": "^3.1.0",
		"typescript": "^5.3.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}

